{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicel",
  "version": "0.1.0",
  "identifier": "com.voicel.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voicel",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Voicel is listening",
        "url": "index.html?overlay",
        "width": 520,
        "height": 86,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
